+// Retain the previous Crystal selection until the user chooses a named effect.
+fn glass_effect(config: &cosmic_config::Config) -> u8 {
+    match config.get::<String>("glass_effect").ok().as_deref() {
+        Some("aero") => 2,
+        Some("crystal") => 1,
+        Some("frosted") => 0,
+        _ => u8::from(config.get::<bool>("crystal_enabled").unwrap_or(false)),
+    }
+}
+
+fn update_aero_config(config: &cosmic_config::Config) {
+    use crate::backend::render::wayland::blur_effect;
+    blur_effect::set_aero_blur(config.get::<u8>("aero_blur_amount").unwrap_or(45));
+    blur_effect::set_aero_color(config.get::<u8>("aero_color").unwrap_or(55));
+    blur_effect::set_aero_reflections(config.get::<u8>("aero_reflections").unwrap_or(65));
+}
+
+// Read the finer percentage when present, retaining the old 0–13 preference otherwise.
+fn crystal_blur_amount(config: &cosmic_config::Config) -> u8 {
+    config
+        .get::<u8>("crystal_blur_amount")
+        .unwrap_or_else(|_| {
+            let legacy = config.get::<u8>("crystal_blur").unwrap_or(3).min(13);
+            ((u16::from(legacy) * 100 + 6) / 13) as u8
+        })
+        .min(100)
+}
+
